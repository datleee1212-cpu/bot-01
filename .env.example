# Sao chép thành .env rồi điền. KHÔNG đưa file .env lên GitHub.
TIMEZONE=Asia/Ho_Chi_Minh

# --- Facebook Page ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
# META_GRAPH_VERSION=v23.0

# --- Instagram (tài khoản chuyên nghiệp liên kết với Page) ---
IG_USER_ID=
# IG_TOKEN=            # bỏ trống thì dùng FB_PAGE_TOKEN

# Link công khai cho ảnh Instagram (chọn 1 trong 2)
# MEDIA_BASE_URL=https://raw.githubusercontent.com/<user>/<repo>/main/posts
# S3_BUCKET=
# S3_ENDPOINT_URL=      # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- X (Twitter) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Bài có link tốn ~$0.20 thay vì ~$0.015. Đặt false để bỏ link trên X.
X_INCLUDE_LINKS=true

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# TIKTOK_REFRESH_TOKEN=   # hoặc chạy: python -m bot tiktok-login
# inbox = đẩy vào hộp nháp TikTok (khuyên dùng); direct = đăng thẳng (riêng tư nếu app chưa audit)
TIKTOK_MODE=inbox
